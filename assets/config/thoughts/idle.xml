<?xml version="1.0" encoding="UTF-8"?>
<!-- Idle quips: what a colonist thinks about when nothing else is on their mind. No mood effect. -->
<thoughts>
  <thought id="idle_musing" importance="trivial">
    <feeling is="bored"/>
    <feeling is="amused" when="attribute(intelligence) >= 14"/>
    <line>My butt itches.</line>
    <line>Is that cloud a horse?</line>
    <line>I could eat a whole tree.</line>
    <line feeling="amused">Trees are just tall grass.</line>
    <line feeling="amused">What if fish think we're the weird ones?</line>
  </thought>
</thoughts>
