<?xml version="1.0" encoding="UTF-8"?>
<!--
  Priority Tuning Configuration
  Tunable weights for task priority calculations.

  AI ARBITRATION uses a lexicographic (tier, score) key (see colonist-task-arbitration.md):
    - tier (TaskTiers below): categorical, compared first. Lower number = higher priority.
      Runtime classifiers promote specific options (critical need -> 2, serves-work-order -> 4).
    - score = distanceFactor + skillBonus + taskAgeBonus + hysteresisBonus, compared only WITHIN
      a tier. It can never lift an option across a tier boundary.

  See /docs/design/game-systems/colonists/priority-config.md for details.
-->
<PriorityTuning>
  <!--
    AI arbitration tiers, per task type. Lower number = higher priority; tier is compared before
    score. These are BASE tiers; AIDecisionSystem promotes specific options at runtime:
      FulfillNeed: needValue<10% -> 2 (critical); gather-food sentinel -> 7; else stays 5.
      Haul/Harvest/PlacePackaged: serving an active work order (or carrying) -> 4; else stays 6.
    Every task type the engine can evaluate MUST have an entry here or load fails (validateTaskTiers).
  -->
  <TaskTiers>
    <Task name="FulfillNeed" tier="5"/>
    <Task name="Craft" tier="4"/>
    <Task name="Build" tier="4"/>
    <Task name="Deconstruct" tier="4"/>
    <Task name="Haul" tier="6"/>
    <Task name="Harvest" tier="6"/>
    <Task name="PlacePackaged" tier="6"/>
    <Task name="Wander" tier="7"/>
  </TaskTiers>

  <!-- Work category tier ordering (for simple mode) -->
  <WorkCategoryOrder>
    <Category name="Emergency" tier="1"/>
    <Category name="Medical" tier="2"/>
    <Category name="Farming" tier="3"/>
    <Category name="Crafting" tier="4"/>
    <Category name="Construction" tier="5"/>
    <Category name="Hauling" tier="6"/>
    <Category name="Cleaning" tier="7"/>
  </WorkCategoryOrder>

  <!-- Bonus calculations -->
  <Bonuses>
    <!-- Within-tier distance factor (AI arbitration): the dominant within-tier score term.
         factor(d) = maxFactor * max(0, 1 - d/maxDistance). Weighted to dominate skill (0-100)
         and task age (0-100) across the working range, so the nearest reachable source wins
         within a tier. maxFactor (300) also exceeds the hysteresis margin (50) for a clearly
         closer alternative, so a much nearer same-tier target overcomes stickiness. -->
    <DistanceFactor>
      <maxDistance>60.0</maxDistance>
      <maxFactor>300.0</maxFactor>
    </DistanceFactor>

    <!-- In-progress: within-tier hysteresis margin. Added to the current task's score so a
         same-tier challenger must beat it by more than this to win (prevents thrashing). Equals
         taskSwitchThreshold below. Only matters within a tier; never lifts across a tier. -->
    <InProgress>
      <bonus>50</bonus>
    </InProgress>

    <!-- Task age: old unclaimed tasks slowly rise in priority -->
    <TaskAge>
      <bonusPerMinute>1</bonusPerMinute>
      <maxBonus>100</maxBonus>
    </TaskAge>

    <!-- Storage priority: within-tier (tier 6) ordering of storage-stocking hauls by the
         destination box's per-item priority (Low..Critical, ranked 0..3). The within-tier score
         gains rank * weight, so a higher-priority box wins even when farther. Set to the distance
         factor's max (300) so storage priority DOMINATES distance within tier 6. Tier is compared
         first, so this can never preempt a tier-5 need or tier-4 work order. -->
    <StoragePriority>
      <weight>300</weight>
    </StoragePriority>
  </Bonuses>

  <!-- Thresholds and timings -->
  <Thresholds>
    <!-- Minimum priority gap to switch tasks while action in progress -->
    <taskSwitchThreshold>50</taskSwitchThreshold>

    <!-- How often colonists re-evaluate tasks (seconds) -->
    <reEvalInterval>0.5</reEvalInterval>
  </Thresholds>

  <!-- Hauling-specific tuning to avoid the "hauling problem" -->
  <HaulingTuning>
    <!-- Boost haul priority when storage is critically low -->
    <storageCriticalThreshold>0.2</storageCriticalThreshold>
    <storageCriticalBonus>500</storageCriticalBonus>

    <!-- Boost if loose item is blocking construction -->
    <blockingConstructionBonus>1000</blockingConstructionBonus>

    <!-- Boost if item is perishable and will spoil soon -->
    <perishableSpoilThreshold>60.0</perishableSpoilThreshold>
    <perishableBonus>800</perishableBonus>

    <!-- Batch nearby items to reduce task spam -->
    <batchRadius>8.0</batchRadius>
    <maxBatchSize>5</maxBatchSize>
  </HaulingTuning>
</PriorityTuning>
