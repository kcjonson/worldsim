<?xml version="1.0" encoding="UTF-8"?>
<!--
  The kinds near() and count_near() look for. A kind maps to one of:
    capability="..."  things a colonist's memory holds under that capability, spelled as asset
                      definitions spell it under <capabilities>;
    mover="..."       movers of that asset definition the colonist saw within the recent-sighting
                      window (assets/config/colonists/memory.xml), at the places he last saw them.
  A kind with neither is declared but nothing answers it, so it reads Unknown and a condition naming it
  is logged. A mod adds a kind, or replaces one's mapping, with a <Kind> in a file of its own.
-->
<ConditionVocabulary>
  <Kind name="colonist" mover="Human"/>
  <Kind name="food" capability="edible"/>
  <Kind name="storage" capability="storage"/>
  <Kind name="station" capability="craftable"/>
  <Kind name="bed" capability="sleepable"/>
  <Kind name="loose_item" capability="carryable"/>
  <Kind name="latrine" capability="toilet"/>
  <Kind name="structure"/>
  <Kind name="lit_fire"/>
  <Kind name="door"/>
  <Kind name="tool"/>
  <Kind name="prepared_food"/>
</ConditionVocabulary>
