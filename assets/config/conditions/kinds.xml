<?xml version="1.0" encoding="UTF-8"?>
<!--
  The kinds near() and count_near() look for, and the capability a colonist's memory holds each under,
  spelled as asset definitions spell it under <capabilities>. A kind with no capability is declared but
  nothing answers it, so it reads Unknown and a condition naming it is logged.
  A mod adds a kind, or gives one a capability, with a <Kind> in a file of its own.
-->
<ConditionVocabulary>
  <Kind name="colonist"/>
  <Kind name="food" capability="edible"/>
  <Kind name="storage" capability="storage"/>
  <Kind name="station" capability="craftable"/>
  <Kind name="bed" capability="sleepable"/>
  <Kind name="loose_item" capability="carryable"/>
  <Kind name="latrine" capability="toilet"/>
  <Kind name="structure"/>
  <Kind name="lit_fire"/>
  <Kind name="door"/>
  <Kind name="tool"/>
  <Kind name="prepared_food"/>
</ConditionVocabulary>
