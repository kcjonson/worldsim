<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mood tuning. See /docs/design/game-systems/colonists/mood.md and needs.md "Mood System".

  Target mood = the needs score + every held thought's mood effect, clamped 0 to 100.
  Needs score = 100 x (1 - sum(weight x penalty) / sum(weight)).
  Mood moves toward its target at up to pointsPerGameHour.
-->
<Mood>
  <Easing pointsPerGameHour="5"/>

  <!-- A need's penalty, 0 to 1: none at or above comfortable, rising to penaltyAtWarning at warning,
       then steeply to 1 at an empty need. Values are need percentages. -->
  <NeedPenalty comfortable="70" warning="30" penaltyAtWarning="0.3"/>

  <!-- Names are the needs' labels. A need left out carries no weight in mood. -->
  <NeedWeights>
    <Need name="Hygiene" weight="1.0"/>
    <Need name="Temperature" weight="1.0"/>
    <Need name="Recreation" weight="0.9"/>
    <Need name="Energy" weight="0.7"/>
    <Need name="Hunger" weight="0.6"/>
    <Need name="Thirst" weight="0.6"/>
    <Need name="Bladder" weight="0.3"/>
    <Need name="Digestion" weight="0.3"/>
  </NeedWeights>

  <!-- Names for the player; they gate nothing. A band runs from its from up to the next band's. -->
  <Bands>
    <Band name="Content" from="55"/>
    <Band name="Low" from="30"/>
    <Band name="Very low" from="12"/>
    <Band name="Collapsing" from="0"/>
  </Bands>
</Mood>
