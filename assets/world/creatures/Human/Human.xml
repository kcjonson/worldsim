<?xml version="1.0" encoding="UTF-8"?>
<!-- Human Asset Definition - Directional sprites for 4-way movement -->
<AssetDefinitions>
  <!-- Base human -->
  <AssetDef>
    <defName>Human</defName>
    <assetType>simple</assetType>
    <svgPath>human.svg</svgPath>
    <motion>biped.motion.xml</motion>
    <worldHeight>1.0</worldHeight>
    <!-- The creature: its behaviors and mood costs, read by the creature loader, not the asset registry. -->
    <creature mood="true"/>
  </AssetDef>

  <!-- Directional variants -->
  <AssetDef>
    <defName>Human_up</defName>
    <assetType>simple</assetType>
    <svgPath>human_up.svg</svgPath>
    <motion>biped.motion.xml</motion>
    <worldHeight>1.0</worldHeight>
  </AssetDef>

  <AssetDef>
    <defName>Human_down</defName>
    <assetType>simple</assetType>
    <svgPath>human_down.svg</svgPath>
    <motion>biped.motion.xml</motion>
    <worldHeight>1.0</worldHeight>
  </AssetDef>

  <AssetDef>
    <defName>Human_left</defName>
    <assetType>simple</assetType>
    <svgPath>human_left.svg</svgPath>
    <motion>biped.motion.xml</motion>
    <worldHeight>1.0</worldHeight>
  </AssetDef>

  <AssetDef>
    <defName>Human_right</defName>
    <assetType>simple</assetType>
    <svgPath>human_right.svg</svgPath>
    <motion>biped.motion.xml</motion>
    <worldHeight>1.0</worldHeight>
  </AssetDef>
</AssetDefinitions>
