<?xml version="1.0" encoding="UTF-8"?>
<!--
  Needs: the levels each need moves between and the most mood it costs. See
  /docs/technical/interruptable-crafts.md (Needs in three levels) and
  /docs/design/game-systems/colonists/needs.md.

  <Need name seek urgent critical cost/>
    seek, urgent, critical   need percentages, each below the one before. A need is at its top level at
                             or above seek, and one level lower below each threshold.
    cost                     the most mood the need takes off, at its worst (a penalty of 1 on mood.xml's
                             curve); zero or more, and 0 leaves it out of mood.

  Names are the needs' labels; every need is given. The colonists' AI seeks a need's fulfilment below
  seek, and thought sources name a threshold a need falls below or rises back to (assets/config/thoughts).

  Every file in this folder with a <Needs> root loads, in file name order; a later file's <Need>
  replaces the earlier one of the same name, cost included.
-->
<Needs>
  <Need name="Hunger"      seek="50" urgent="25" critical="10" cost="25"/>
  <Need name="Thirst"      seek="50" urgent="25" critical="10" cost="25"/>
  <Need name="Energy"      seek="30" urgent="20" critical="10" cost="20"/>
  <Need name="Bladder"     seek="30" urgent="20" critical="10" cost="10"/>
  <Need name="Digestion"   seek="30" urgent="20" critical="10" cost="10"/>
  <Need name="Hygiene"     seek="40" urgent="25" critical="15" cost="15"/>
  <Need name="Recreation"  seek="30" urgent="20" critical="10" cost="15"/>
  <Need name="Temperature" seek="40" urgent="25" critical="15" cost="60"/>
</Needs>
