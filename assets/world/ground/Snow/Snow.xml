<?xml version="1.0" encoding="UTF-8"?>
<!-- Snow ground tile: soft off-white snow (ground_bare.lua). Wind-packed and quiet: faint drifts lit
     along their upper edges over a cool blue lee, soft blue hollows, dense faint grain, sparse ice
     sparkle that only the nearest zooms show, and the odd twig or grass tip poking through. -->
<AssetDefinitions>
  <AssetDef>
    <defName>Ground_Snow</defName>
    <label>Snow</label>
    <role>ground</role>
    <surface>Snow</surface>
    <assetType>procedural</assetType>
    <generator>
      <scriptPath>@shared/ground_bare.lua</scriptPath>
      <params>
        <!-- Must equal <period> below. The knobs are documented in Dirt.xml and Rock.xml; sparkle and
             grass tips are here. -->
        <period>4</period>
        <baseColor>#E1E7EE</baseColor>

        <!-- Regions (documented in Rock.xml): tone is the wind-packed snow, faintly brighter mounds
             and cool blue hollows, stretched across the screen by the wind; ledge is the drifts, each
             lit along its upper edge and shaded in a cool blue (ledgeShade) along its lower one, so
             they read as soft sculpted shapes, never as lines. -->
        <toneWaves>48</toneWaves>
        <toneCycles>3,14</toneCycles>
        <toneStretch>1.8</toneStretch>
        <toneSlope>2.6</toneSlope>
        <toneLevels>0.36,0.12,-0.34,-0.12</toneLevels>
        <toneColors>#E5EAF0,#E9EDF3,#DAE2EC,#D4DCE8</toneColors>
        <ledgeWaves>40</ledgeWaves>
        <ledgeCycles>3,10</ledgeCycles>
        <ledgeStretch>2.2</ledgeStretch>
        <ledgeSlope>2.2</ledgeSlope>
        <ledgeLevels>0.3</ledgeLevels>
        <ledgeColors>#E3E8EE</ledgeColors>
        <ledgeBevel>0.022</ledgeBevel>
        <ledgeShade>#D3DCE8</ledgeShade>

        <!-- Grain: dense, faint sugar. -->
        <grainDensity>1200</grainDensity>
        <grainSize>0.006,0.012</grainSize>
        <grainContrast>0.035</grainContrast>

        <twigDensity>0.3</twigDensity>
        <twigLength>0.05,0.12</twigLength>
        <twigWidth>0.009,0.013</twigWidth>
        <twigColors>#4A3A2C,#5C4A36</twigColors>
        <twigShadow>0.8</twigShadow>

        <stoneDensity>0.5</stoneDensity>
        <stoneSize>0.015,0.04</stoneSize>
        <stoneColors>#7A766E,#8A857C</stoneColors>
        <stoneShadow>0.75</stoneShadow>
        <stoneLit>1.25</stoneLit>

        <!-- Grass tips: two to four short strokes fanning up from a root, over a shadow tipShadow times
             the ground's light. -->
        <tipDensity>0.3</tipDensity>
        <tipLength>0.05,0.1</tipLength>
        <tipWidth>0.009,0.012</tipWidth>
        <tipColors>#6B6847,#827A52,#5A5A40</tipColors>
        <tipShadow>0.82</tipShadow>

        <!-- Sparkle: four-point stars sparkleSize across in sparkleColors, at mip 0 only. -->
        <sparkleDensity>20</sparkleDensity>
        <sparkleSize>0.016,0.024</sparkleSize>
        <sparkleColors>#FFFFFF,#FFFFFF,#F2F8FF,#FFF8E8</sparkleColors>

        <farContrast>0.9</farContrast>
        <farGain>0.9996,0.9971,0.9991</farGain>

        <!-- Heights (documented in Dirt.xml): one flat, mid height for all the snow, so it ranks as one tie
             group, and only twigs, stones and grass tips stand out of it. -->
        <heightBase>0.5</heightBase>
        <heightRelief>0</heightRelief>
      </params>
    </generator>
    <variantCount>8</variantCount>
    <period>4</period>
    <pixelsPerMeter>64</pixelsPerMeter>
    <!-- Lit from the top and its drifts run across the screen: cells only flip left to right. -->
    <rotate>mirror</rotate>
    <macro>
      <dry>1.02,1.01,0.98</dry>
      <lush>0.98,0.99,1.02</lush>
      <amplitude>0.3</amplitude>
    </macro>
    <!-- How Snow meets the ones below it (docs/technical/ground-textures.md, "Pair parameters"): crisp, filling
         the lower surface's low spots before it covers its tops, with a contact shadow and a bright ridge
         for a lip and no veil; mud stains. -->
    <transition>
      <width>0.8</width>
      <offset>0.25</offset>
      <softness>0.04</softness>
      <shadow>0.35</shadow>
      <breakup>0.6</breakup>
      <ridge>0.08</ridge>
    </transition>
    <transition over="Mud">
      <width>0.25</width>
      <softness>0.2</softness>
      <stain>0.25</stain>
      <offset>0</offset>
      <shadow>0</shadow>
      <ridge>0</ridge>
    </transition>
  </AssetDef>
</AssetDefinitions>
